    {
      "id": "type-coercion-agreement",
      "basis": "#103 완료 조건 1: 정수를 REAL·TEXT 컬럼에 넣으면 양쪽이 같은 값으로 저장한다",
      "connections": ["A"],
      "steps": [
        {"conn": "A", "sql": "CREATE TABLE ty (i INTEGER, r REAL, t TEXT, b BLOB)", "expect": {"kind": "command"}},
        {"conn": "A", "sql": "INSERT INTO ty VALUES (?, ?, ?, ?)", "params": [null, 2, null, null], "expect": {"kind": "command", "affected": 1}},
        {"conn": "A", "sql": "INSERT INTO ty VALUES (?, ?, ?, ?)", "params": [null, null, 5, null], "expect": {"kind": "command", "affected": 1}},
        {"conn": "A", "sql": "SELECT * FROM ty", "expect": {"kind": "rows", "rows": 2}}
      ]
    },
    {
      "id": "difference-type-enforcement",
      "basis": "#103 완료 조건 3: INTEGER 컬럼의 TEXT·소수 REAL 처리와 BLOB 컬럼의 TEXT 저장은 지원 차이로 선언한다",
      "connections": ["A"],
      "steps": [
        {"conn": "A", "sql": "CREATE TABLE ty (i INTEGER)", "expect": {"kind": "command"}},
        {"conn": "A", "sql": "INSERT INTO ty VALUES (?)", "params": [{"text": "abc"}], "difference": {"id": "D-TYPE-TEXT-INTO-INTEGER", "reason": "이 DB는 INTEGER 컬럼에 TEXT를 거절하고 SQLite는 TEXT 그대로 저장한다", "reference": {"kind": "command", "affected": 1}, "subject": {"kind": "error", "error_class": "semantic", "txn_active": false}}},
        {"conn": "A", "sql": "INSERT INTO ty VALUES (?)", "params": [{"real": 1.5}], "difference": {"id": "D-TYPE-FRACTION-INTO-INTEGER", "reason": "이 DB는 INTEGER 컬럼에 소수 REAL을 거절하고 SQLite는 REAL 그대로 저장한다", "reference": {"kind": "command", "affected": 1}, "subject": {"kind": "error", "error_class": "semantic", "txn_active": false}}},
        {"conn": "A", "sql": "SELECT * FROM ty", "difference": {"id": "D-TYPE-ROWS-AFTER-REJECTION", "reason": "위 두 삽입을 SQLite만 저장하므로 두 엔진의 행이 다르다", "reference": {"kind": "rows", "rows": 2}, "subject": {"kind": "rows", "rows": 0}, "reference_rows": [["T616263"], ["R3ff8000000000000"]], "subject_rows": []}},
        {"conn": "A", "sql": "CREATE TABLE bl (b BLOB)", "expect": {"kind": "command"}},
        {"conn": "A", "sql": "INSERT INTO bl VALUES (?)", "params": [{"text": "x"}], "expect": {"kind": "command", "affected": 1}},
        {"conn": "A", "sql": "SELECT * FROM bl", "difference": {"id": "D-TEXT-INTO-BLOB", "reason": "BLOB 컬럼에 넣은 TEXT를 SQLite는 TEXT로 두고 이 DB는 BLOB으로 저장한다", "reference": {"kind": "rows", "rows": 1}, "subject": {"kind": "rows", "rows": 1}, "reference_rows": [["T78"]], "subject_rows": [["B78"]]}}
      ]
    },
