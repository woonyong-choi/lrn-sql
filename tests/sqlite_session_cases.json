        {"conn": "A", "sql": "BEGIN", "expect": {"kind": "command", "txn_active": true}},
        {"conn": "A", "sql": "INSERT INTO s (v) VALUES (?)", "params": [{"text": "v2 rolled back"}], "expect": {"kind": "command", "affected": 1}},
        {"conn": "A", "sql": "ROLLBACK", "expect": {"kind": "command", "txn_active": false}},
        {"conn": "A", "sql": "INSERT INTO s (v) VALUES (?)", "params": [{"text": "v3"}], "expect": {"kind": "command", "affected": 1}},
        {"conn": "A", "sql": "SELECT * FROM s", "expect": {"kind": "rows", "rows": 2}},
        {"conn": "A", "sql": "DELETE FROM s WHERE id = ?", "params": [2], "expect": {"kind": "command", "affected": 1}},
        {"conn": "A", "sql": "INSERT INTO s (v) VALUES (?)", "params": [{"text": "v4"}], "expect": {"kind": "command", "affected": 1}},
        {"conn": "A", "sql": "INSERT INTO s (id, v) VALUES (?, ?)", "params": [10, {"text": "explicit"}], "expect": {"kind": "command", "affected": 1}},
        {"conn": "A", "sql": "INSERT INTO s (v) VALUES (?)", "params": [{"text": "v5"}], "expect": {"kind": "command", "affected": 1}},
        {"conn": "A", "sql": "SELECT * FROM s", "expect": {"kind": "rows", "rows": 4}},
        {"restart": "clean"},
        {"conn": "A", "sql": "INSERT INTO s (v) VALUES (?)", "params": [{"text": "v6"}], "expect": {"kind": "command", "affected": 1}},
        {"conn": "A", "sql": "SELECT * FROM s", "expect": {"kind": "rows", "rows": 5}}
      ]
    },
