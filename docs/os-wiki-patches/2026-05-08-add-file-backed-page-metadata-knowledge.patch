+mapping base      = 0x10000000
+access index      = 5000 = 0x1388
+access VA         = 0x10001388
+VA page base      = 0x10001000
+offset in page    = 0x388
+page file offset  = 0x2000
+actual file byte  = 0x2000 + 0x388 = 0x2388
